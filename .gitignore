tools/blender/_*_debug.png

# League of Legends downloads (raw game files) stay local; the converted GLBs in
# public/models/lol/ are committed so the game has them
tools/blender/lol/_cache/
# League of Legends renders (derived from Riot assets): local only
docs/art/lol/

# Meshy client (tools/meshy): job folders are committed (paid outputs, kept 3 days by Meshy);
# test-key runs and partial downloads are not
tools/meshy/jobs/*_test/
tools/meshy/jobs/**/*.part
tools/meshy/__pycache__/
